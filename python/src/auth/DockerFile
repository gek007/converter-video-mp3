FROM python:3.12-slim

WORKDIR /app

# Install system dependencies required for MySQL client
RUN apt-get update && apt-get install -y \
    default-libmysqlclient-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy the service file
COPY service.py .

# Copy the pyproject.toml for dependencies
COPY ../../../pyproject.toml .

# Install Python dependencies
RUN pip install --no-cache-dir -r <(pip-compile pyproject.toml 2>/dev/null || echo "flask flask-mysqldb pyjwt python-dotenv requests") || \
    pip install --no-cache-dir flask flask-mysqldb pyjwt python-dotenv requests

# Expose the port the Flask app runs on
EXPOSE 5000

# Run the application
CMD ["python", "service.py"]
